@model Eventos.Web.Models.Evento
@{
    ViewData["Title"] = "Eliminar evento";
}

<h1>Eliminar evento</h1>
<h5 class="text-danger">¿Seguro que desea eliminar este evento?</h5>

<dl class="row">
    <dt class="col-sm-3">Título</dt><dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Lugar</dt><dd class="col-sm-9">@Model.Lugar</dd>
    <dt class="col-sm-3">Categoría</dt><dd class="col-sm-9">@Model.Categoria?.Nombre</dd>
    <dt class="col-sm-3">Modalidad</dt><dd class="col-sm-9">@Model.Modalidad</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
