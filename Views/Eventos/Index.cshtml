@model List<Eventos.Web.Repositorios.EventoItem>
@{
    ViewData["Title"] = "Eventos";
}

<h1>Eventos</h1>

<div class="d-flex justify-content-between align-items-end mb-3">
    <form method="get" class="d-flex gap-2 align-items-end">
        <div>
            <label class="form-label" for="categoriaId">Categoría</label>
            <select id="categoriaId" name="categoriaId" class="form-select" asp-items="(SelectList)ViewBag.Categorias">
                <option value="">-- Todas --</option>
            </select>
        </div>
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </form>
    <a asp-action="Create" class="btn btn-primary">Nuevo evento</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Título</th>
            <th>Fecha</th>
            <th>Lugar</th>
            <th>Categoría</th>
            <th>Modalidad</th>
            <th>Precio</th>
            <th>Aforo</th>
            <th>Inscritos</th>
            <th>Cupos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Evento.Titulo</td>
                <td>@item.Evento.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@item.Evento.Lugar</td>
                <td>@item.Categoria</td>
                <td>@item.Evento.Modalidad</td>
                <td>@item.Evento.Precio.ToString("C2")</td>
                <td>@item.Evento.Aforo</td>
                <td>@item.Inscritos</td>
                <td>@item.Cupos</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Evento.Id">Detalle</a> |
                    <a asp-action="Edit" asp-route-id="@item.Evento.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.Evento.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
