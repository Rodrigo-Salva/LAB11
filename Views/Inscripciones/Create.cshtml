@model Eventos.Web.Models.Inscripcion
@{
    ViewData["Title"] = "Nueva inscripción";
}

<h1>Nueva inscripción</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="EventoId" class="form-label"></label>
        <select asp-for="EventoId" class="form-select" asp-items="(SelectList)ViewBag.Eventos">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="EventoId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AsistenteId" class="form-label"></label>
        <select asp-for="AsistenteId" class="form-select" asp-items="(SelectList)ViewBag.Asistentes">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="AsistenteId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Inscribir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
